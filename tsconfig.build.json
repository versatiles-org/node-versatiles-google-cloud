{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"],
	// Mocks are excluded alongside the tests they exist for. Only *.test.ts was
	// listed, so the mocks compiled into dist and were published — scaffolding
	// shipped to every consumer, and importable as if it were part of the API.
	"exclude": ["src/**/*.test.ts", "src/**/*.mock.ts"]
}
